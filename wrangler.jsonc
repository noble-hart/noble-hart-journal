
{
  "name": "noble-hart-journal",
  "compatibility_date": "2026-11-13",
  "main": "worker.js",
  "keep_vars": true,
  "ratelimits": [
    {
      "name": "COMMENT_RATE_LIMITER",
      "namespace_id": "142001",
      "simple": {"limit": 8, "period": 60}
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/sitemap.xml", "/api/comments"]
  }
}
